# Configuración de Entorno de Caramel
# Copia este archivo como .env y coloca la URL de conexión de tu base de datos en la nube.

# Ejemplo para PostgreSQL en la Nube (Supabase, Neon, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://usuario:contraseña@ep-xyz.aws.neon.tech/neondb?sslmode=require
# o para Supabase:
# DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Por defecto si no se define, utiliza SQLite local:
DATABASE_URL=sqlite:///./caramel.db
