# Configuración de Entorno de Caramel
# Copia este archivo como .env y coloca la URL de conexión de tu base de datos en la nube.

# Ejemplo para PostgreSQL en la Nube (Supabase, Neon, Render, Railway, AWS RDS):
# DATABASE_URL=postgresql://usuario:contraseña@ep-xyz.aws.neon.tech/neondb?sslmode=require
# o para Supabase:
# DATABASE_URL=postgresql://postgres.xxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Por defecto si no se define, utiliza SQLite local:
DATABASE_URL=sqlite:///./caramel.db

# Clave secreta para firmar cookies de sesión con HMAC-SHA256 (genera una aleatoria en producción)
SESSION_SECRET_KEY=cambia-esta-clave-por-una-cadena-aleatoria-larga

# Correo institucional de soporte técnico mostrado en el enlace de recuperación del login
SUPPORT_EMAIL=soporte.caramel@unimar.edu.ve

# Opcional: solo si inicializas una base de datos vacía desde cero (sin credenciales hardcodeadas)
# CARAMEL_ADMIN_EMAIL=admin@unimar.edu.ve
# CARAMEL_ADMIN_USERNAME=admin
# CARAMEL_ADMIN_FULL_NAME=Administrador Caramel
# CARAMEL_ADMIN_PASSWORD=cambia-esta-clave-segura
